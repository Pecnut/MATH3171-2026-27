Cell[BoxData[{
 RowBox[{
  RowBox[{"xPoints", "=", 
   RowBox[{"Range", "[", 
    RowBox[{
     RowBox[{"-", "L"}], ",", "L", ",", 
     RowBox[{"2", 
      RowBox[{"L", "/", "100"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"uPoints", "=", 
   RowBox[{
    RowBox[{"Evaluate", "[", 
     RowBox[{
      RowBox[{"u", "[", 
       RowBox[{"xPoints", ",", "tmax"}], "]"}], "/.", "sol"}], "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"vPoints", "=", 
   RowBox[{
    RowBox[{"Evaluate", "[", 
     RowBox[{
      RowBox[{"v", "[", 
       RowBox[{"xPoints", ",", "tmax"}], "]"}], "/.", "sol"}], "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dudtPoints", "=", 
   RowBox[{
    RowBox[{"Evaluate", "[", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"u", "[", 
          RowBox[{"xPoints", ",", "t"}], "]"}], "/.", "sol"}], ",", "t"}], 
       "]"}], "/.", 
      RowBox[{"t", "\[Rule]", "tmax"}]}], "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dvdtPoints", "=", 
