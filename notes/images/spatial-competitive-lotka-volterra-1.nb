          RowBox[{"xPoints", ",", "t"}], "]"}], "/.", "sol"}], ",", "t"}], 
       "]"}], "/.", 
      RowBox[{"t", "\[Rule]", "tmax"}]}], "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";"}]}], "Input",
