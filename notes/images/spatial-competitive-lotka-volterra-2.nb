        RowBox[{
         RowBox[{"u", "[", 
          RowBox[{"x", ",", "t"}], "]"}], 
         RowBox[{"(", 
          RowBox[{"1", "-", 
           RowBox[{"u", "[", 
            RowBox[{"x", ",", "t"}], "]"}], "-", 
           RowBox[{"\[Gamma]1", " ", 
